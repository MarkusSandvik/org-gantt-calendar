# Copy to .env and adjust for your environment. All settings are read with
# the APP_ prefix (see app/core/config.py). Never commit a real .env file.

APP_DATABASE_URL=sqlite:///./data/app.db
APP_CORS_ORIGINS=["http://localhost:5173"]
APP_ENVIRONMENT=local

# Selects the active app/organizations/<id>/config.py profile (branding,
# seed data). Defaults to "default" — the neutral example org — when
# unset, so local dev needs no configuration. See ORGANIZATION_PLAN.md.
APP_ORGANIZATION=default

# Auth / sessions
APP_SESSION_COOKIE_NAME=session
APP_CSRF_COOKIE_NAME=csrf
APP_SESSION_TTL_HOURS=336
APP_INVITATION_TTL_HOURS=168
APP_PASSWORD_RESET_TTL_HOURS=2
APP_LOGIN_RATE_LIMIT_ATTEMPTS=10
APP_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Local development only — the seed script hashes this and assigns it to
# every seeded account. Never set this in a real deployment.
APP_DEV_SEED_PASSWORD=DevPassword123!
