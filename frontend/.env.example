# Copy to .env and adjust for your environment. Vite only exposes
# variables prefixed with VITE_ to client code. Never commit a real .env.

# Selects the active src/branding/profiles/<id>.ts profile (product name,
# favicon, feature flags). Defaults to "default" — the neutral example
# org — when unset, so local dev needs no configuration. See
# ORGANIZATION_PLAN.md.
VITE_ORGANIZATION=default
